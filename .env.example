# 后端
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CAMPUS_ADMIN_STUDENT_NO=admin001
CAMPUS_ADMIN_EMAIL=admin@your-school.edu.cn
CAMPUS_ADMIN_PASSWORD=
CAMPUS_SCHOOL_EMAIL_DOMAIN=@your-school.edu.cn

# 大模型 API Key（启用 AI 审核与校园知识库问答；切勿提交真实值）
# 兼容 OpenAI /chat/completions 的服务均可，默认示例为阿里云百炼（DashScope）
CAMPUS_AI_API_KEY=
CAMPUS_AI_ENABLED=false
CAMPUS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CAMPUS_AI_CHAT_MODEL=qwen-plus
CAMPUS_AI_MODERATION_ENABLED=true
# 审核模式：post=先发布后复核（默认，不阻断发帖/评论）；pre=先审后发；off=不审核直接发布
CAMPUS_AI_MODERATION_MODE=post

# 上传文件可访问基址（图片/头像返回的绝对 URL 前缀；须与前端对外访问域名一致，
# 且该域名下 /uploads 需可访问——Docker 由前端 Nginx 反代 /uploads 到 backend 实现）
# 例：https://your-domain.com ；留空则后端返回相对路径 /uploads/...（仍由 Nginx 反代提供）
CAMPUS_UPLOAD_BASE_URL=

# 前端（构建时注入）
VITE_API_BASE_URL=https://your-domain.com
